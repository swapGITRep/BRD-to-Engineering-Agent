# ============================================================
# IK_BRD_Dev_Agent — ENVIRONMENT VARIABLES
# Copy to .env and fill in your values.
# ============================================================

# ─── OpenAI (all agents use gpt-4.1) ─────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4.1
OPENAI_EMBED_MODEL=text-embedding-3-large
# OPENAI_BASE_URL=                       # optional: gateway/proxy base URL

# ─── LangSmith Observability (optional) ──────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...your_langsmith_key...
LANGCHAIN_PROJECT=brd-dev-agent
# US region (default). EU: https://eu.api.smith.langchain.com
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─── Runtime paths (Azure infra overrides these) ─────────
VECTORSTORE_DIR=./vectorstore
CHECKPOINT_DB=./checkpoints/langgraph_states.db
ARTIFACT_STORE=local                     # local | blob

# ─── Azure Blob (only when ARTIFACT_STORE=blob) ──────────
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# AZURE_BLOB_CONTAINER=brd-artifacts

# ─── Azure Monitor (set automatically in Container Apps) ──
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# ─── Jira (optional — PoC Planner's check_related_jira_tickets tool) ────
# Leave unset to run without it: the tool reports "not configured" and the
# PoC Planner proceeds without the check, it does not fail the run.
# JIRA_SITE_URL=https://yourcompany.atlassian.net
# JIRA_EMAIL=you@yourcompany.com
# JIRA_API_TOKEN=                        # generate at id.atlassian.com/manage-profile/security/api-tokens
# JIRA_PROJECT=                          # project name or key to scope the search to; blank = unscoped
