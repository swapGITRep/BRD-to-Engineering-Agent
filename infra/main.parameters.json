{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "namePrefix": { "value": "${AZURE_ENV_NAME=brdagent}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "containerImage": { "value": "${SERVICE_WEB_IMAGE_NAME=mcr.microsoft.com/k8se/quickstart:latest}" },

    "keyVaultName": { "value": "${KEY_VAULT_NAME=}" },
    "existingEnvironmentName": { "value": "${EXISTING_CONTAINER_APPS_ENV=}" },
    "existingAcrName": { "value": "${EXISTING_ACR_NAME=}" },
    "appInsightsConnectionString": { "value": "${APPLICATIONINSIGHTS_CONNECTION_STRING=}" },

    "openAiApiKey": { "value": "${OPENAI_API_KEY}" },
    "langchainApiKey": { "value": "${LANGCHAIN_API_KEY=}" },
    "openAiModel": { "value": "${OPENAI_MODEL=gpt-4.1}" },
    "openAiEmbedModel": { "value": "${OPENAI_EMBED_MODEL=text-embedding-3-large}" },
    "langchainTracing": { "value": "${LANGCHAIN_TRACING_V2=true}" },
    "langchainProject": { "value": "${LANGCHAIN_PROJECT=brd-dev-agent}" },
    "langchainEndpoint": { "value": "${LANGCHAIN_ENDPOINT=https://api.smith.langchain.com}" }
  }
}
